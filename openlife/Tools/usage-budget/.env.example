# Copy this file to ".env" in the same folder and fill in values.
# .env is gitignored and must NEVER be committed or shared.
#
# How to get values after "grok login":
#   .\export-auth-to-env.ps1
# (reads %USERPROFILE%\.grok\auth.json and writes local .env only)

# Required: API / CLI bearer key (the "key" field from auth.json)
GROK_API_KEY=

# Required: user id (the "user_id" field from auth.json)
GROK_USER_ID=

# Optional overrides
# GROK_CLI_CHAT_PROXY_BASE_URL=https://cli-chat-proxy.grok.com/v1
# GROK_CLIENT_MODE=
