# Copy to .env and fill in. NEVER commit .env (gitignored).
# Do not paste real account keys into issues, PRs, logs, or screenshots.
OHOL_HOST=127.0.0.1
OHOL_PORT=8005
OHOL_EMAIL=
OHOL_PASSWORD=x
OHOL_ACCOUNT_KEY=

# Optional: skip Account form when creds are complete (client defaults on if unset).
# OHOL_AUTO_CONNECT=1
